# ============================================================
# MyPlace — variaveis de ambiente
# Copie este arquivo para .env.local e preencha.
# NUNCA faca commit de .env.local. Veja docs/SETUP.md.
# ============================================================

# ---------- FASE 1: obrigatorias ----------

# Supabase — Project Settings > API
# A URL e a anon key sao publicas por design (protegidas por RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVICE ROLE: ignora RLS. Somente servidor. Nunca exponha no frontend,
# nunca prefixe com NEXT_PUBLIC_, nunca mande para o navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres do Supabase — Project Settings > Database > Connection string
# Use a porta 5432 (conexao direta) para rodar migracoes.
DATABASE_URL=

# URL publica do app. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- FASE 3: mapas e geocodificacao ----------
# 'google' (melhor cobertura no Brasil, pago por uso) ou 'maptiler'
GEOCODING_PROVIDER=
GOOGLE_GEOCODING_API_KEY=
# Chave de tiles do mapa (publica, restrinja por dominio no painel MapTiler)
NEXT_PUBLIC_MAPTILER_KEY=

# ---------- FASE 7: pagamentos (Asaas) ----------
# Comece SEMPRE em sandbox.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Token que voce define no painel do Asaas e que valida o webhook recebido.
ASAAS_WEBHOOK_TOKEN=

# ---------- FASE 6: emails transacionais ----------
RESEND_API_KEY=
EMAIL_FROM="MyPlace <nao-responda@seudominio.com.br>"

# ---------- Seguranca: rate limiting ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Fase 12: monitoramento de erro (Sentry) ----------
# DSN do projeto — sentry.io > Settings > Projects > (projeto) > Client Keys
NEXT_PUBLIC_SENTRY_DSN=
# Usados so no build, para subir source map legivel ao Sentry. Opcionais:
# sem eles o app funciona igual, so o stack trace no painel vem minificado.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---------- Fase 16: classificacao de padrao do espaco (IA de visao) ----------
# console.anthropic.com > Settings > API Keys. Sem isso, o botao de
# classificar o espaco mostra "nao configurado" em vez de fingir um resultado.
ANTHROPIC_API_KEY=

# ---------- Fase 18: notificacoes agendadas (Vercel Cron) ----------
# Voce mesmo gera um valor aleatorio longo (ex.: openssl rand -hex 32).
# A Vercel manda esse valor automaticamente no header Authorization de toda
# chamada agendada quando o projeto tem essa env var definida. Sem ela, a
# rota /api/cron/notificacoes recusa a chamada em vez de rodar sem checar.
CRON_SECRET=
