# ============================================================
# MyPlace — variaveis de ambiente
# Copie este arquivo para .env.local e preencha.
# NUNCA faca commit de .env.local. Veja docs/SETUP.md.
# ============================================================

# ---------- FASE 1: obrigatorias ----------

# Supabase — Project Settings > API
# A URL e a anon key sao publicas por design (protegidas por RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVICE ROLE: ignora RLS. Somente servidor. Nunca exponha no frontend,
# nunca prefixe com NEXT_PUBLIC_, nunca mande para o navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres do Supabase — Project Settings > Database > Connection string
# Use a porta 5432 (conexao direta) para rodar migracoes.
DATABASE_URL=

# URL publica do app. Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- FASE 3: mapas e geocodificacao ----------
# 'google' (melhor cobertura no Brasil, pago por uso) ou 'maptiler'
GEOCODING_PROVIDER=
GOOGLE_GEOCODING_API_KEY=
# Chave de tiles do mapa (publica, restrinja por dominio no painel MapTiler)
NEXT_PUBLIC_MAPTILER_KEY=
# Imagem aerea (satelite) do mapa de exploracao. A chave do MapTiler acima ja liga o modo
# satelite (estilo "hybrid"). Alternativa: um servidor de tiles aereos proprio/contratado.
# Sem nenhuma das duas, o botao "Satelite" aparece desligado (a plataforma nao finge ter imagem aerea).
NEXT_PUBLIC_SATELLITE_TILE_URL=
NEXT_PUBLIC_SATELLITE_TILE_ATTRIBUTION=

# ---------- FASE 7: pagamentos (Asaas) ----------
# Comece SEMPRE em sandbox.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
# Token que voce define no painel do Asaas e que valida o webhook recebido.
ASAAS_WEBHOOK_TOKEN=

# ---------- FASE 6: emails transacionais ----------
RESEND_API_KEY=
EMAIL_FROM="MyPlace <nao-responda@seudominio.com.br>"

# ---------- Seguranca: rate limiting ----------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------- Fase 12: monitoramento de erro (Sentry) ----------
# DSN do projeto — sentry.io > Settings > Projects > (projeto) > Client Keys
NEXT_PUBLIC_SENTRY_DSN=
# Usados so no build, para subir source map legivel ao Sentry. Opcionais:
# sem eles o app funciona igual, so o stack trace no painel vem minificado.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ---------- Fase 16: classificacao de padrao do espaco (IA de visao) ----------
# console.anthropic.com > Settings > API Keys. Sem isso, o botao de
# classificar o espaco mostra "nao configurado" em vez de fingir um resultado.
ANTHROPIC_API_KEY=

# ---------- Fase 18: notificacoes agendadas (Vercel Cron) ----------
# Voce mesmo gera um valor aleatorio longo (ex.: openssl rand -hex 32).
# A Vercel manda esse valor automaticamente no header Authorization de toda
# chamada agendada quando o projeto tem essa env var definida. Sem ela, a
# rota /api/cron/notificacoes recusa a chamada em vez de rodar sem checar.
CRON_SECRET=

# ---------- Fase 19: notificacao push no navegador (Web Push/VAPID) ----------
# Gere o par com: npx web-push generate-vapid-keys
# A publica leva NEXT_PUBLIC_ de proposito — nao e segredo, o navegador da
# pessoa precisa dela pra assinar a inscricao.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Um mailto: ou https: seu, exigido pelo protocolo Web Push.
VAPID_SUBJECT=mailto:contato@seudominio.com.br

# ---------- Fase 21: verificacao de telefone por SMS (Twilio Verify) ----------
# console.twilio.com > Account Info (SID e Auth Token) e
# Verify > Services (Service SID, comeca com VA). Sem as tres, a tela de
# verificacoes diz que o SMS nao esta disponivel e nenhum codigo e enviado.
# O Auth Token e SEGREDO — nunca com NEXT_PUBLIC_.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# So para os testes automatizados (aponta para o duble local). Em producao,
# deixe sem definir.
# TWILIO_VERIFY_BASE_URL=

# Benefício do primeiro mês do Premium (atrás de feature flag desligada): segredo do HMAC do CPF. Veja docs/PREMIUM-BENEFICIO.md
IDENTITY_HASH_SECRET=
