# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# worker do MapLibre, copiado de node_modules por scripts/copy-maplibre-worker.mjs
/public/maplibre/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — segredos nunca entram no repositorio.
# .env.example e versionado de proposito (so contem chaves vazias).
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# drizzle
/drizzle/meta/_journal.json.bak

# dados locais
/.docker-data/
.next-teste
standalone/.build/
sites/*/.build/
sites/*/videos/
